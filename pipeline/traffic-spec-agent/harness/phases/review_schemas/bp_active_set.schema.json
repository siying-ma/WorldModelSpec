{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:traffic-spec:bp_active_set",
 "title": "a law's active property set (written by the harness)",
 "description": "The property set a law's check uses and the operator's withdrawals, in order. A withdrawal names the withdrawn property by `identity`, the digest of its normalized identity; it removes from the active set exactly the properties of that identity, never another property with the same antecedent, another category or another binder class. `antecedent_sha` and `property` (the display id) serve reports only. Only an operator's decision appends a withdrawal; no model answer can.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "law",
  "active_set_id",
  "set_id",
  "supersedes",
  "version",
  "withdrawals"
 ],
 "properties": {
  "schema": {
   "const": "bp_active_set/1"
  },
  "law": {
   "type": "string",
   "minLength": 1
  },
  "active_set_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{32,64}$"
  },
  "set_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{32,64}$"
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ]
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "withdrawals": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/withdrawal"
   }
  }
 },
 "$defs": {
  "withdrawal": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "identity",
    "antecedent_sha",
    "property",
    "decision_sha",
    "date"
   ],
   "properties": {
    "identity": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "antecedent_sha": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "property": {
     "type": "string",
     "pattern": "^P[0-9]{1,3}$"
    },
    "decision_sha": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "format": "date-time"
    }
   }
  }
 }
}
