DECL	{"assumptions":["asm.in_business_or_residential_district"],"binders":["v"],"id":"NRS_484B_413_2","intentions":[],"laws":["NRS-484B-413-2"],"narrowings":[{"kind":"reading","span":"s1","why":"The hand of the course change is read from the sign of kin.yaw_rate at the judged observation: strictly positive is left, strictly negative is right. At an observation whose rate of change of heading is exactly zero no hand is read, so the duty of s1 is stated for a course change whose rate of change of heading is non-zero where it is recognized; the signal is required on the hand the sign gives and a signal on the other hand does not satisfy it."}],"operationalizations":[],"residues":["The words add no observable condition and no restriction: the signal is owed over the same window, in the same terms, whether or not rain, snow, wet road, ice or any other weather is present, so the duty is the same whether or not these words hold. The rule reads no weather atom for them, and nothing of the obligation is dropped."],"surrogate":false}
