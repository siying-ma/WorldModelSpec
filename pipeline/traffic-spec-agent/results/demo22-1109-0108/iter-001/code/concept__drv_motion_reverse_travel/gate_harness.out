DECL	{"args":[{"name":"u","sort":{"sort":"track"}}],"body":{"cmp":"le","lhs":{"add":[{"mul":[{"args":[{"var":"u"},{"lit":"x"}],"measure":"kin_velocity"},{"args":[{"var":"u"},{"lit":"x"}],"measure":"kin_heading"}]},{"mul":[{"args":[{"var":"u"},{"lit":"y"}],"measure":"kin_velocity"},{"args":[{"var":"u"},{"lit":"y"}],"measure":"kin_heading"}]}]},"rhs":{"neg":{"param":"reverse_speed_tolerance"}}},"contract":"The road user is travelling rearward at the observation: the component of its velocity along the direction its body points is at most the negative of the reverse speed tolerance, a speed the caller sets, so that a rearward component smaller than it is read as none. The concept states the direction of the body's motion relative to the direction it points, at the observation only, and says nothing of how long the rearward motion lasts or where it happens. Not a stand-in for: the gear selected — a body in a forward gear rolls backwards on a grade and one in reverse stands still — a reversing lamp or any other signal, a halt, a turn, or the place the motion happens at.","definition":null,"id":"drv.motion.reverse_travel","kind":"formula","narrowings":[],"params":[{"name":"reverse_speed_tolerance","unit":"metre_per_second"}],"residues":[],"supersedes":null}
