DECL	{"assumptions":[],"binders":["v"],"id":"NRS_484B_600_1a","intentions":[],"laws":["NRS-484B-600-1a"],"narrowings":[{"kind":"reading","span":"s3","why":"The standard's conditions are read at the regions the subject occupies and that lie on the highway it occupies: the longitudinal slope (st.grade) and the sight distance (st.sight_distance) at the roadway region, read as 'the subject's place', and the width (st.lane_width) at the lane region, read as the 'width of the highway' the record narrows to the lane the vehicle runs in. The record names st.highway, st.roadway, st.lane and st.on_way without saying which region carries which figure; this is the assignment chosen."},{"kind":"reading","span":"s3","why":"'the highway' and 'the lane' are definite in the words; where more than one occupied region of a kind qualifies, the bound is required at every one of them (a universal over the selected regions) rather than at one of them, which is the stricter of the readings the words allow."}],"operationalizations":[{"concepts":["env.ice_or_snow","env.precipitation","env.visibility","env.wet_road","kin.speed","rel.occupies","st.grade","st.highway","st.lane","st.lane_width","st.on_way","st.roadway","st.sight_distance"],"params":["p.reasonable_speed_base_limit","p.reasonable_speed_wet_decrement","p.reasonable_speed_ice_decrement","p.reasonable_speed_traffic_decrement_per_user","p.reasonable_speed_grade_decrement_per_unit_grade","p.reasonable_speed_lane_width_time","p.reasonable_speed_sight_time"],"standard":"a rate of speed greater than is reasonable or proper, having due regard for the traffic, surface and width of the highway, the weather and other highway conditions","surrogate":true}],"residues":[],"surrogate":true}
