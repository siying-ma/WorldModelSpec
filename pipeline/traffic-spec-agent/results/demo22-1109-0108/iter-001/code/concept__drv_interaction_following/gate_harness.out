DECL	{"args":[{"name":"a","sort":{"sort":"track"}},{"name":"b","sort":{"sort":"track"}}],"body":{"and":[{"args":[{"var":"b"},{"var":"a"}],"atom":"rel_ahead_behind_in_lane","params":[]},{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"same_direction_tolerance"}]}]},"contract":"Road user a is following road user b at the observation: b is ahead of a in the same lane along that lane's direction of travel, and the two bodies' headings are aligned within the same-direction tolerance, a cosine the caller sets. It is a relation of place and direction at the observation; it states no gap, no speed, no duration and no intention. Not a stand-in for: the size of the space between the two — a caller that bounds a space reads the gap atom itself — overtaking or passing, two road users abreast in neighbouring lanes, or a towed combination, which is one road user drawn by another.","definition":null,"id":"drv.interaction.following","kind":"formula","narrowings":[],"params":[{"name":"same_direction_tolerance","unit":"ratio"}],"residues":[],"supersedes":null}
