DECL	{"args":[{"name":"a","sort":{"sort":"track"}}],"body":{"add":[{"mul":[{"args":[{"var":"a"}],"measure":"kin_speed"},{"param":"reaction_time"}]},{"div":[{"mul":[{"args":[{"var":"a"}],"measure":"kin_speed"},{"args":[{"var":"a"}],"measure":"kin_speed"}]},{"mul":[{"lit":{"den":1,"num":2},"unit":"count"},{"param":"deceleration"}]}]}]},"contract":"The distance road user a would travel before coming to rest if it began to brake after a reaction time, at the observation: its speed (kin.speed, m/s) times the reaction time, plus the square of its speed divided by twice the deceleration (m). Computed from the current speed only, under a constant deceleration on a level road. Not a stand-in for a sight distance or a gap to another road user, which a caller compares it with, nor for a braking manoeuvre actually made.","definition":null,"id":"drv.motion.stopping_distance","kind":"quantity","narrowings":[],"params":[{"name":"reaction_time","unit":"second"},{"name":"deceleration","unit":"metre_per_second_sq"}],"residues":[],"supersedes":null}
