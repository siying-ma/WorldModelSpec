DECL	{"args":[{"name":"a","sort":{"sort":"track"}}],"body":{"cmp":"lt","lhs":{"add":[{"mul":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_velocity"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"}]},{"mul":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_velocity"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"}]}]},"rhs":{"neg":{"param":"motion_tolerance"}}},"contract":"A road user is backing at an observation: it moves in the direction opposite to the one its body points. Measured as the component of its velocity (kin.velocity, m/s, world frame) along its heading (kin.heading, unit vector) lying below the negative of the motion tolerance, the speed below which a sampled motion counts as none. Not a stand-in for the gear selected: a vehicle in reverse gear that stands still or rolls forward is not backing, and one in a forward gear that rolls backwards is.","definition":null,"id":"drv.motion.backing","kind":"formula","narrowings":[],"params":[{"name":"motion_tolerance","unit":"metre_per_second"}],"residues":[],"supersedes":null}
