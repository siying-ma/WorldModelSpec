DECL	{"args":[{"name":"a","sort":{"sort":"track"}},{"name":"b","sort":{"sort":"track"}}],"body":{"and":[{"rises":{"args":[{"var":"b"},{"var":"a"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]}},{"since":[{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"alignment"}]},{"args":[{"var":"a"},{"var":"b"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]}]}]},"contract":"Road user a overtakes and passes road user b: travelling with headings aligned, a goes from wholly behind b to wholly ahead of it. The act is recognized at the observation at which a becomes wholly ahead of b, that is, at which drv.position.behind of b relative to a becomes true, provided that a was behind b (drv.position.behind of a relative to b) at an earlier observation and the headings stayed aligned (rel.same_direction with the alignment tolerance) at every observation from that one to the recognition. Its observed beginning is the last observation at which a was behind b before the recognition. The concept holds at the recognition observation only. Where the recording shows no observation of a behind b before a becomes wholly ahead of it, with the headings aligned at every observation since the recording began, whether a overtook b is unknown, never false. Not a stand-in for a lane change or for contact between the bodies; it does not say in which lane either travels.","definition":null,"id":"drv.interaction.overtakes","kind":"formula","narrowings":[],"params":[{"name":"alignment","unit":"ratio"}],"residues":[],"supersedes":null}
ATOMS	drv_position_behind,rel_same_direction
READS	rel_same_direction,rel_bearing,rel_longitudinal_overlap
AGGREGATES	
HARDAGG	
BODY	{"and":[{"rises":{"and":[{"args":[{"var":"b"},{"var":"a"}],"atom":"rel_same_direction","params":[{"param":"alignment"}]},{"and":[{"args":[{"var":"b"},{"var":"a"},{"lit":"ahead"}],"atom":"rel_bearing","params":[]},{"cmp":"lt","lhs":{"args":[{"var":"b"},{"var":"a"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}}]}]}},{"since":[{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"alignment"}]},{"and":[{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"alignment"}]},{"and":[{"args":[{"var":"a"},{"var":"b"},{"lit":"ahead"}],"atom":"rel_bearing","params":[]},{"cmp":"lt","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}}]}]}]}]}
