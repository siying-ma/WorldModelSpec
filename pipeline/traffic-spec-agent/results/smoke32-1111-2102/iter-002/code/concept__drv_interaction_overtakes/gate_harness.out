DECL	{"args":[{"name":"a","sort":{"sort":"track"}},{"name":"b","sort":{"sort":"track"}}],"body":{"and":[{"rises":{"and":[{"args":[{"var":"b"},{"var":"a"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]},{"not":{"args":[{"var":"a"},{"var":"b"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]}}]}},{"since":[{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"alignment"}]},{"and":[{"args":[{"var":"a"},{"var":"b"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]},{"not":{"args":[{"var":"b"},{"var":"a"}],"derived":"drv_position_behind","params":[{"param":"alignment"}]}}]}]}]},"contract":"Road user a overtakes and passes road user b: travelling with headings aligned, a goes from wholly behind b to wholly ahead of it. a is wholly behind b at an observation where drv.position.behind of a relative to b holds and drv.position.behind of b relative to a does not; a is wholly ahead of b where drv.position.behind of b relative to a holds and drv.position.behind of a relative to b does not. Where both hold, as headings that are aligned but not parallel allow for bodies apart sideways, a is neither wholly behind nor wholly ahead of b. The act is recognized at the observation at which a becomes wholly ahead of b, provided that a was wholly behind b at an earlier observation and the headings stayed aligned (rel.same_direction with the alignment tolerance) at every observation from that one to the recognition. Its observed beginning is the last observation at which a was wholly behind b before the recognition. The concept holds at the recognition observation only. Where the recording shows no observation of a wholly behind b before a becomes wholly ahead of it, with the headings aligned at every observation since the recording began, whether a overtook b is unknown, never false. Not a stand-in for a lane change or for contact between the bodies; it does not say in which lane either travels.","definition":null,"id":"drv.interaction.overtakes","kind":"formula","narrowings":[],"params":[{"name":"alignment","unit":"ratio"}],"residues":[],"supersedes":null}
ATOMS	drv_position_behind,rel_same_direction
