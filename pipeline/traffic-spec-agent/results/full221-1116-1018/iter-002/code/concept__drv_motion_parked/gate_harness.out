TIME	scenario:drv.motion.parked@w/fails	15
SCEN	blind	drv.motion.parked@w	unknown	unknown	ok
TIME	scenario:drv.motion.parked@w/blind	17
TIME	witnesses	48
DONE_WITNESSES
