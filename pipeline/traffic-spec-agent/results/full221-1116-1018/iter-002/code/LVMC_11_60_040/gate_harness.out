DECL	{"assumptions":[],"binders":["subject"],"id":"LVMC_11_60_040","intentions":[],"laws":["LVMC-11-60-040"],"narrowings":[],"operationalizations":[],"residues":["'This provision shall not prevent' a temporary passenger stop: the words leave such a stop to the other stopping and parking regulations, which judge it by their own rules. A temporary stop that breaches another regulation is that regulation's violation; under this provision it is neither standing nor parking (DEF-NRS-484A-250, DEF-NRS-484A-155), so this rule's verdict is the same whether or not the stop complies with the others."],"surrogate":false}
