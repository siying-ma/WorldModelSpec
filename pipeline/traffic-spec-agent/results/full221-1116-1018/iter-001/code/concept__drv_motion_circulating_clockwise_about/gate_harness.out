DECL	{"args":[{"name":"a","sort":{"sort":"track"}},{"name":"r","sort":{"sort":"region"}}],"body":{"and":[{"cmp":"lt","lhs":{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_velocity"}]},"rhs":{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_velocity"}]}},{"and":[{"cmp":"gt","lhs":{"mul":[{"sub":[{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_velocity"}]},{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_velocity"}]}]},{"sub":[{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_velocity"}]},{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_region_geometry"}]},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_velocity"}]}]}]},"rhs":{"mul":[{"mul":[{"mul":[{"param":"sin_tol"},{"param":"sin_tol"}]},{"add":[{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_region_geometry"}]},{"sub":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_region_geometry"}]}]},{"mul":[{"sub":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_region_geometry"}]},{"sub":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_region_geometry"}]}]}]}]},{"mul":[{"args":[{"var":"a"}],"measure":"kin_speed"},{"args":[{"var":"a"}],"measure":"kin_speed"}]}]}},{"cmp":"gt","lhs":{"args":[{"var":"a"}],"measure":"kin_speed"},"rhs":{"param":"speed_tol"}}]}]},"contract":"Road user a travels clockwise about the reference point of region r, as seen from above: the point lies to the right of a's direction of travel and a's velocity turns about it clockwise. It is observed with a's position (kin.position), a's velocity (kin.velocity), a's speed (kin.speed) and r's reference point (st.region_geometry), in the world frame, in which a turn to the left is counter-clockwise (the frame of kin.yaw_rate): with d the vector from r's reference point to a's position, the cross product of d with a's velocity is negative, and its square exceeds sin_tol squared times the squared length of d times the square of a's speed, so that the share of a's motion that turns about the point is above sin_tol; and a's speed is above speed_tol. It is a state at one observation: it says nothing of whether a occupies r, of the path a followed before, or of why a moves so. Not denoted: a road user at rest or moving at or below speed_tol; one travelling counter-clockwise about the point; one moving towards or away from the point within the angle sin_tol allows; one at the point itself. Where r's reference point, a's position or a's velocity is unobserved, it is unknown.","definition":null,"id":"drv.motion.circulating_clockwise_about","kind":"formula","narrowings":[],"params":[{"name":"speed_tol","unit":"metre_per_second"},{"name":"sin_tol","unit":"ratio"}],"residues":[],"supersedes":null}
