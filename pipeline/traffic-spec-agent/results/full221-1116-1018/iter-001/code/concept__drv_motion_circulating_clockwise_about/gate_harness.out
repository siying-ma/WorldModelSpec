":"a"}],"measure":"kin_speed"},{"args":[{"var":"a"}],"measure":"kin_speed"}]}]}},{"cmp":"gt","lhs":{"args":[{"var":"a"}],"measure":"kin_speed"},"rhs":{"param":"speed_tol"}}]}]}
