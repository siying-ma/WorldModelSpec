HARDAGG	
BODY	{"and":[{"cmp":"gt","lhs":{"add":[{"mul":[{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_lane_direction"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"}]},{"mul":[{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_lane_direction"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"}]}]},"rhs":{"lit":{"den":1,"num":0},"unit":"ratio"}},{"and":[{"cmp":"lt","lhs":{"sub":[{"mul":[{"args":[{"var":"r"},{"lit":"x"}],"measure":"st_lane_direction"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"}]},{"mul":[{"args":[{"var":"r"},{"lit":"y"}],"measure":"st_lane_direction"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"}]}]},"rhs":{"neg":{"param":"sin_tol"}}},{"cmp":"gt","lhs":{"args":[{"var":"a"}],"measure":"kin_speed"},"rhs":{"param":"speed_tol"}}]}]}
