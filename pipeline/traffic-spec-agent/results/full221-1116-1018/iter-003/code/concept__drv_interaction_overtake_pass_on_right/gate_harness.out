DECL	{"args":[{"name":"a","sort":{"sort":"track"}},{"name":"b","sort":{"sort":"track"}}],"body":{"and":[{"args":[{"var":"a"},{"var":"b"}],"derived":"drv_interaction_overtake_pass","params":[{"param":"window"},{"param":"same_dir_cos"}]},{"and":[{"args":[{"var":"a"},{"var":"b"},{"lit":"left"}],"atom":"rel_bearing","params":[]},{"since":[{"implies":[{"cmp":"ge","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"args":[{"var":"a"},{"var":"b"},{"lit":"left"}],"atom":"rel_bearing","params":[]}]},{"and":[{"and":[{"cmp":"gt","lhs":{"add":[{"mul":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"}]}]},{"mul":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"}]}]}]},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"cmp":"lt","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}}]},{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"same_dir_cos"}]}]}]}]}]},"contract":"Road user a overtakes and passes road user b on b's right: a overtakes and passes b from the rear, as drv.interaction.overtake_pass states it with the same window and the same heading tolerance, and makes the passage with b on its left. b is on a's left where the lateral component of b's bearing in a's frame (rel.bearing) is positive; the two are side by side where their projections on a's heading share length (rel.longitudinal_overlap at or above zero). b is ahead of a where the longitudinal component, along a's heading (kin.heading), of the vector from a's position to b's position (kin.position) is positive and the two bodies' projections on a's heading share no length (rel.longitudinal_overlap negative); their headings are aligned where the cosine of the angle between them is above same_dir_cos (rel.same_direction). The act begins at the last observation of the window behind at which b was ahead of a with their headings aligned within same_dir_cos. The act is recognized at the observation at which drv.interaction.overtake_pass holds for a and b, where b is on a's left there and at every observation since the act began at which the two are side by side. The concept holds at that observation only, and not again until b has again been ahead of a and then comes to be behind it. Conduct before the window behind is not read: a pass that takes longer than the window is not recognized. It denotes the relative motion of the two road users and the side on which a passes only: it says nothing of the lanes or the pavement a uses, of whether b moves, or of why a passes. Not denoted: a pass with b on a's right at the recognition or at some observation at which the two are side by side, which is a pass on b's left; a drawing alongside b that does not clear b; b ahead of a only while their headings are not aligned. Where b's bearing, the positions or headings of a and b, or the overlap of the two bodies is unobserved at an observation the passage reads, it is unknown.","definition":null,"id":"drv.interaction.overtake_pass_on_right","kind":"formula","narrowings":[],"params":[{"name":"window","unit":"second"},{"name":"same_dir_cos","unit":"ratio"}],"residues":[],"supersedes":null}
