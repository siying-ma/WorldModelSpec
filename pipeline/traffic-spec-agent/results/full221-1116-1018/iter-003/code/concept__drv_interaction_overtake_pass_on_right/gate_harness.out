rection","params":[{"param":"same_dir_cos"}]}]}]}}},{"at_last":"time","body":"tt","length":{"param":"window"},"subject":"a","when":{"and":[{"and":[{"cmp":"gt","lhs":{"add":[{"mul":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"}]}]},{"mul":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"}]}]}]},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"cmp":"lt","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}}]},{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"same_dir_cos"}]}]}}]}]},{"and":[{"args":[{"var":"a"},{"var":"b"},{"lit":"left"}],"atom":"rel_bearing","params":[]},{"since":[{"implies":[{"cmp":"ge","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"args":[{"var":"a"},{"var":"b"},{"lit":"left"}],"atom":"rel_bearing","params":[]}]},{"and":[{"and":[{"cmp":"gt","lhs":{"add":[{"mul":[{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"x"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"x"}],"measure":"kin_position"}]}]},{"mul":[{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_heading"},{"sub":[{"args":[{"var":"b"},{"lit":"y"}],"measure":"kin_position"},{"args":[{"var":"a"},{"lit":"y"}],"measure":"kin_position"}]}]}]},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"cmp":"lt","lhs":{"args":[{"var":"a"},{"var":"b"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}}]},{"args":[{"var":"a"},{"var":"b"}],"atom":"rel_same_direction","params":[{"param":"same_dir_cos"}]}]}]}]}]}
