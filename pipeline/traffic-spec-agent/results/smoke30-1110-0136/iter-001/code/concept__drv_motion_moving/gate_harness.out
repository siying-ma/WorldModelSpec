DECL	{"args":[{"name":"x","sort":{"sort":"track"}}],"body":{"cmp":"gt","lhs":{"args":[{"var":"x"}],"measure":"kin_speed"},"rhs":{"param":"tol"}},"contract":"A road user is in motion at the observation: the magnitude of its velocity (kin.speed) exceeds `tol`, a tolerance that names only the source's speed resolution, below which a reading counts as standing still. It denotes motion in any direction, forwards or backwards, whoever or whatever controls the road user. Not denoted: the direction of motion; a halt held over a window, since the concept reads the one observation.","definition":null,"id":"drv.motion.moving","kind":"formula","narrowings":[],"params":[{"name":"tol","unit":"metre_per_second"}],"residues":[],"supersedes":null}
