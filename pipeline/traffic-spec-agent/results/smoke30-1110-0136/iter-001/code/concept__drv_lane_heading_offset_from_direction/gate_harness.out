DECL	{"args":[{"name":"x","sort":{"sort":"track"}},{"name":"c","sort":{"sort":"region"}}],"body":{"sub":[{"mul":[{"args":[{"var":"c"},{"lit":"x"}],"measure":"st_lane_direction"},{"args":[{"var":"x"},{"lit":"y"}],"measure":"kin_heading"}]},{"mul":[{"args":[{"var":"c"},{"lit":"y"}],"measure":"st_lane_direction"},{"args":[{"var":"x"},{"lit":"x"}],"measure":"kin_heading"}]}]},"contract":"The signed departure of a road user's heading from a carrier's designated direction of travel at the observation, left positive: the sine of the angle from the carrier's direction (st.lane_direction) to the road user's heading (kin.heading), computed as the cross product of the two normalised vectors, the direction's first component times the heading's second minus the direction's second component times the heading's first. A ratio between -1 and 1 up to the normalisation factor both atoms carry; positive where the heading points to the left of the direction, negative where it points to the right, zero where it is aligned with or exactly opposed to it. Not denoted: occupancy of the carrier, which the caller states; whether the road user points with or against the direction, since a heading and its mirror across the perpendicular give the same value, which the caller states where it matters; the direction of motion, since the concept reads where the road user points, not where it moves; a carrier with no designated direction, for which the value is unknown.","definition":null,"id":"drv.lane.heading_offset_from_direction","kind":"quantity","narrowings":[],"params":[],"residues":[],"supersedes":null}
