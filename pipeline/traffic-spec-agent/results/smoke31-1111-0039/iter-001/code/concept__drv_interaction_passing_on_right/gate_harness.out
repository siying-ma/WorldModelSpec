DECL	{"args":[{"name":"x","sort":{"sort":"track"}},{"name":"y","sort":{"sort":"track"}}],"body":{"and":[{"args":[{"var":"x"},{"var":"y"}],"atom":"rel_same_direction","params":[{"param":"aligned_cosine"}]},{"and":[{"cmp":"gt","lhs":{"args":[{"var":"x"},{"var":"y"}],"measure":"rel_longitudinal_overlap"},"rhs":{"lit":{"den":1,"num":0},"unit":"metre"}},{"and":[{"args":[{"var":"x"},{"var":"y"},{"lit":"left"}],"atom":"rel_bearing","params":[]},{"cmp":"gt","lhs":{"sub":[{"args":[{"var":"x"}],"measure":"kin_speed"},{"args":[{"var":"y"}],"measure":"kin_speed"}]},"rhs":{"param":"speed_margin"}}]}]}]},"contract":"Road user x is passing road user y on y's right at the observation: the side-by-side phase of an overtaking. It holds where their headings are aligned (rel.same_direction, with aligned_cosine as the relation's tolerance), their bodies overlap along x's heading (rel.longitudinal_overlap positive), y lies on x's left (the lateral component of rel.bearing of y from x, in x's frame), and x's speed exceeds y's (kin.speed, m/s) by more than speed_margin, the speed resolution below which the two count as keeping pace. Not denoted: the approach from behind or the return ahead of y, where either body is on the road, a lane change, contact, or the clearance between the bodies.","definition":null,"id":"drv.interaction.passing_on_right","kind":"formula","narrowings":[],"params":[{"name":"aligned_cosine","unit":"ratio"},{"name":"speed_margin","unit":"metre_per_second"}],"residues":[],"supersedes":null}
ATOMS	rel_same_direction,rel_longitudinal_overlap,rel_bearing,kin_speed
