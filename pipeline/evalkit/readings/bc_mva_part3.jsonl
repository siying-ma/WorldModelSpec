// Readings of the BC Motor Vehicle Act [RSBC 1996] c.318, Part 3 (ss.119-214).
// One line per ATOMIC OBLIGATION, not per section: a section with three duties
// becomes three readings, because a label is only attributable if it names one
// thing the driver did or failed to do.
//
// `text` is an excerpt for orientation. The CITATION is authoritative; a
// reviewer checks the reading against the statute, never against this excerpt.
//
// Every `quantifications` entry with kind "reading" is a judgement a human must
// sign off. That review, at roughly ten minutes an obligation, is the entire
// human cost of the label pipeline, and it is paid once per jurisdiction rather
// than once per capture.
{"id":"BC-MVA-146-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.146(1)","text":"a person must not drive or operate a motor vehicle on a highway in a municipality, treaty lands or a Nisga'a village at a greater rate of speed than 50 km/h","tags":["speed","default_limit"],"scenarios":["VanillaNonSignalizedTurn","MergeIntoSlowTraffic","HighwayExit"],"applies_when":{"all":["ego.lane.on_road",{"gt":["ego.speed_kph",0.5]},{"isnull":"ego.posted.speed_limit_kph"}]},"violated_when":{"sustained":[0.3,{"gt":["ego.speed_kph",50.0]}]},"quantifications":[{"term":"50 km/h","value":50.0,"unit":"kph","kind":"statute","note":"stated in s.146(1)"},{"term":"in a municipality","value":true,"unit":"bool","kind":"reading","note":"CARLA towns are treated as municipalities throughout; no map carries a municipal boundary, so this reading applies the urban default wherever no sign is posted. It is the single assumption that most changes this rule's verdicts and is deliberately not hidden inside the expression."},{"term":"persistence before it counts","value":0.3,"unit":"s","kind":"reading","note":"the statute names no duration. 0.3 s at 20 Hz is 6 frames, long enough to reject a single noisy position difference and far shorter than any deliberate overspeed."}],"notes":"Engaged only where NO sign is posted; s.146(3) takes over where one is. The two are disjoint by construction so a capture cannot be convicted twice for one act."}
{"id":"BC-MVA-146-3","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.146(3)","text":"a person must not, when the sign is in place on the highway, drive or operate a vehicle on that portion of the highway at a greater rate of speed than that indicated","tags":["speed","posted_limit"],"scenarios":["HighwayExit","HighwayCutIn","InterurbanActorFlow"],"applies_when":{"all":["ego.lane.on_road",{"gt":["ego.speed_kph",0.5]},{"notnull":"ego.posted.speed_limit_kph"}]},"violated_when":{"sustained":[0.3,{"gt":["ego.speed_kph","ego.posted.speed_limit_kph"]}]},"quantifications":[{"term":"the rate indicated","value":null,"unit":"kph","kind":"statute","note":"read from the governing OpenDRIVE type-274 landmark; no constant of ours appears in the comparison"},{"term":"landmark_value is km/h","value":"kph","unit":"","kind":"reading","note":"CARLA exports landmark_unit as 'mph' on speed-limit signs while authoring its towns in km/h. Reading it as mph would scale every posted limit by 1.61. The choice is recorded in extract_sg.SPEED_LIMIT_UNIT so a single edit flips it everywhere."},{"term":"persistence before it counts","value":0.3,"unit":"s","kind":"reading","note":"as s.146(1)"}]}
{"id":"BC-MVA-150-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.150(1)","text":"The driver of a vehicle must confine the course of the vehicle to the right hand half of the roadway if the roadway is of sufficient width","tags":["lane","wrong_way"],"scenarios":["AccidentTwoWays","ConstructionObstacleTwoWays","HazardAtSideLaneTwoWays","ParkedObstacleTwoWays","VehicleOpenDoorTwoWays"],"applies_when":{"all":["ego.lane.on_road",{"not":"ego.lane.is_junction"}]},"violated_when":{"sustained":[1.0,"ego.lane.wrong_way"]},"quantifications":[{"term":"confine the course","value":1.0,"unit":"s","kind":"reading","note":"an instantaneous excursion across the centre line while overtaking is what s.157 licenses; one second of sustained travel on the wrong half is not that."}],"notes":"UNTESTABLE on the scene-graph view by construction: process_to_junction_rsv exposes no lane heading, so 'against the flow' is not derivable. This reading is included precisely to make that gap show up as UNTESTABLE in the report rather than as silent compliance -- five of Bench2Drive's 44 scenarios are TwoWays overtakes whose whole point is this clause."}
{"id":"BC-MVA-157-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.157(1)","text":"the driver of a vehicle overtaking another vehicle must cause the vehicle to pass to the left of the other vehicle at a safe distance","tags":["overtaking","clearance"],"scenarios":["Accident","ConstructionObstacle","ParkedObstacle","HazardAtSideLane","VehicleOpenDoorTwoWays"],"applies_when":{"exists_actor":{"all":[{"gt":["actor.rel.heading_dot",0.5]},{"lt":["actor.rel.longitudinal_m",10.0]},{"gt":["actor.rel.longitudinal_m",-10.0]},{"gt":["actor.rel.lateral_m",0.5]},{"ne":["actor.cls",{"lit":"pedestrian"}]}]}},"violated_when":{"exists_actor":{"all":[{"gt":["actor.rel.heading_dot",0.5]},{"lt":["actor.rel.longitudinal_m",10.0]},{"gt":["actor.rel.longitudinal_m",-10.0]},{"between":["actor.rel.lateral_m",0.5,2.5]}]}},"quantifications":[{"term":"a safe distance","value":2.5,"unit":"m","kind":"reading","note":"centre-to-centre, NOT body-to-body: the abstraction carries no bounding box, so a clearance cannot be computed. 2.5 m of centre separation is roughly 0.6 m of clear space between two 1.9 m-wide cars. A body-to-body reading belongs on the simulator view and is the same clause with actor.rel.lateral_gap_m substituted."},{"term":"abreast","value":10.0,"unit":"m","kind":"reading","note":"longitudinal window within which the two vehicles count as passing rather than following"}]}
{"id":"BC-MVA-162-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.162(1)","text":"A driver of a vehicle must not cause or permit the vehicle to follow another vehicle more closely than is reasonable and prudent","tags":["following"],"scenarios":["MergeIntoSlowTraffic","MergerIntoSlowTrafficV2","StaticCutIn","ParkingCutIn","HardBreakRoute"],"applies_when":{"all":["ego.lead.present",{"gt":["ego.speed_mps",2.0]},{"notnull":"ego.lead.headway_s"}]},"violated_when":{"sustained":[1.0,{"lt":["ego.lead.headway_s",2.0]}]},"quantifications":[{"term":"reasonable and prudent","value":2.0,"unit":"s","kind":"reading","note":"quantified as the two-second rule, which is what ICBC's Learn to Drive Smart teaches for this clause in good conditions. THIS IS THE READING THAT MOST NEEDS REVIEW: the statute names no number, and the whole verdict turns on it. Because it is a TIME the fact layer computes (gap / speed), it does not silently become a distance -- which is how the same clause was quantified as 20 m in one place and 4 m in another elsewhere in this project."},{"term":"persistence","value":1.0,"unit":"s","kind":"reading","note":"a momentary cut-in by a third party puts the ego inside two seconds without the ego having done anything; one second of the ego sustaining it is the ego's act."}]}
{"id":"BC-MVA-129-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.129(1)","text":"the driver of a vehicle approaching the intersection and facing the red light must cause it to stop before entering the marked crosswalk","tags":["signal","red_light"],"scenarios":["OppositeVehicleRunningRedLight","VanillaSignalizedTurnEncounterRedLight","SignalizedJunctionLeftTurn","SignalizedJunctionRightTurn"],"applies_when":{"all":[{"eq":["signal.state",{"lit":"Red"}]},"signal.governs_ego_lane",{"not":"ego.lane.is_junction"}]},"violated_when":{"all":[{"onset":"ego.lane.is_junction"},{"prev":{"eq":["signal.state",{"lit":"Red"}]}}]},"quantifications":[{"term":"before entering the marked crosswalk","value":"junction boundary","unit":"","kind":"reading","note":"the abstraction has no crosswalk geometry, so the junction boundary stands in for the stop line. It lies PAST the crosswalk, so this reading is strictly more permissive than the statute: a driver who stops over the crosswalk but short of the junction is convicted by s.129 and acquitted here. Errs toward missing violations, and cannot be tightened until crosswalk polygons reach the fact layer."}],"notes":"The signal is taken from the lane the ego is in, not from a trigger volume. CARLA's Vehicle.get_traffic_light() returns None on the very frame the ego crosses into the junction, which is the one frame this clause turns on."}
{"id":"BC-MVA-186-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.186","text":"a driver of a vehicle must stop at the marked stop line, if any, before entering the marked crosswalk on the near side","tags":["stop_sign"],"scenarios":["VanillaNonSignalizedTurnEncounterStopsign","NonSignalizedJunctionLeftTurn","NonSignalizedJunctionRightTurn"],"applies_when":{"all":[{"notnull":"ego.posted.stop_ahead_m"},{"lt":["ego.posted.stop_ahead_m",30.0]},{"not":"ego.lane.is_junction"}]},"violated_when":{"all":[{"onset":"ego.lane.is_junction"},{"not":{"ever_before":{"sustained":[0.5,{"lt":["ego.speed_mps",0.15]}]}}}]},"quantifications":[{"term":"stop","value":0.15,"unit":"m/s","kind":"reading","note":"a complete stop. CARLA's handbrake-held vehicles jitter at a few cm/s, so exact zero never occurs and would convict every compliant capture."},{"term":"long enough to be a stop","value":0.5,"unit":"s","kind":"reading","note":"s.186 requires a stop and names no duration. Half a second is short enough not to add a requirement the statute does not make, and long enough that a single frame of noise in a rolling stop is not a stop."},{"term":"approach window","value":30.0,"unit":"m","kind":"reading","note":"how near the posted stop must be for the clause to be engaged"}]}
{"id":"BC-MVA-177-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.177","text":"a driver must yield the right of way, and immediately drive to a position parallel to and as close as possible to the nearest edge or curb","tags":["emergency","give_way"],"scenarios":["YieldToEmergencyVehicle"],"applies_when":{"exists_actor":{"all":["actor.is_emergency","actor.emergency_lights_on",{"lt":["actor.rel.centre_distance_m",60.0]}]}},"violated_when":{"sustained":[2.0,{"all":[{"gt":["ego.lane.lanes_to_right",0]},{"not":"ego.lane.is_junction"}]}]},"quantifications":[{"term":"approaching","value":60.0,"unit":"m","kind":"reading","note":"the statute says 'approaching' and names no distance. 60 m is roughly three seconds at an urban limit."},{"term":"displaying lights","value":true,"unit":"bool","kind":"statute","note":"s.177 is engaged by a vehicle displaying its lamps, not by an emergency vehicle merely being present. Read from VehicleLightState Special1/Special2, which the abstraction does carry -- so this is checkable rather than assumed from the blueprint name."},{"term":"immediately","value":2.0,"unit":"s","kind":"reading","note":"grace to complete the manoeuvre before failing to have made it counts as not having yielded"}],"notes":"The 'and stop' half of s.177 is a SEPARATE obligation and is BC-MVA-177-2. Folding them together is what makes an emergency-vehicle label unattributable: a driver who pulls right but does not stop has broken one duty, not both."}
{"id":"BC-MVA-177-2","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.177","text":"a driver must yield the right of way ... and stop","tags":["emergency","give_way","stop"],"scenarios":["YieldToEmergencyVehicle"],"applies_when":{"exists_actor":{"all":["actor.is_emergency","actor.emergency_lights_on",{"lt":["actor.rel.centre_distance_m",60.0]}]}},"violated_when":{"sustained":[3.0,{"gt":["ego.speed_mps",2.0]}]},"quantifications":[{"term":"stop","value":2.0,"unit":"m/s","kind":"reading","note":"a vehicle still doing 2 m/s three seconds after an emergency vehicle came within 60 m has not stopped for it"},{"term":"time allowed to come to rest","value":3.0,"unit":"s","kind":"reading","note":"braking from an urban limit takes about this long; a shorter window would convict a driver who is in the act of complying"}]}
{"id":"BC-MVA-179-1","jurisdiction":"CA-BC","citation":"Motor Vehicle Act (BC) s.179(1)","text":"the driver of a vehicle must yield the right of way to a pedestrian where traffic control signals are not in place or not in operation","tags":["pedestrian","crosswalk","give_way"],"scenarios":["PedestrianCrossing","ParkingCrossingPedestrian","DynamicObjectCrossing","VehicleTurningRoutePedestrian"],"applies_when":{"all":[{"notnull":"ego.posted.crosswalk_ahead_m"},{"lt":["ego.posted.crosswalk_ahead_m",20.0]},{"isnull":"signal.state"},{"exists_actor":{"all":[{"eq":["actor.cls",{"lit":"pedestrian"}]},{"lt":["actor.rel.centre_distance_m",15.0]},"actor.rel.ahead"]}}]},"violated_when":{"sustained":[0.5,{"gt":["ego.speed_mps",1.0]}]},"quantifications":[{"term":"yield","value":1.0,"unit":"m/s","kind":"reading","note":"continuing to roll toward an occupied crosswalk is a failure to yield"},{"term":"at the crosswalk","value":20.0,"unit":"m","kind":"reading","note":"how near the crosswalk the clause engages"}],"notes":"UNTESTABLE on the scene-graph view: no crosswalk geometry reaches the abstraction. Four of Bench2Drive's 44 scenarios are pedestrian-crossing scenarios, so this is the single largest coverage hole the fact schema currently has, and closing it is one call to carla.Map.get_crosswalks() on the simulator side."}
