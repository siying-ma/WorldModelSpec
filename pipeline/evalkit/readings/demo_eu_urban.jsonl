// A SECOND JURISDICTION over the SAME fact tracks, and the same captures.
//
// This file exists to demonstrate the property the whole layering is for: a
// corpus is annotated once, in physical terms, and a jurisdiction is a
// derivation over it. Swapping BC's 50 km/h urban default for a 30 km/h zone
// and a stricter following rule costs two lines here and ZERO re-annotation,
// zero re-simulation, and zero human labelling.
//
// The ids are deliberately not BC's: a label file names the jurisdiction it was
// derived under, so two jurisdictions' verdicts on one capture never collide.
{"id":"EU-URBAN-30","jurisdiction":"DEMO-EU","citation":"illustrative 30 km/h urban zone","text":"In a designated 30 zone a driver must not exceed 30 km/h.","tags":["speed"],"scenarios":["VanillaNonSignalizedTurn"],"applies_when":{"all":["ego.lane.on_road",{"gt":["ego.speed_kph",0.5]},{"isnull":"ego.posted.speed_limit_kph"}]},"violated_when":{"sustained":[0.3,{"gt":["ego.speed_kph",30.0]}]},"quantifications":[{"term":"30 km/h","value":30.0,"unit":"kph","kind":"statute","note":"the zone's posted default"},{"term":"persistence","value":0.3,"unit":"s","kind":"reading","note":"as BC-MVA-146-1; the anti-noise window is a property of the measurement, not of the jurisdiction, and is therefore the same number"}]}
{"id":"EU-URBAN-FOLLOW","jurisdiction":"DEMO-EU","citation":"illustrative 2 s minimum headway, strictly enforced","text":"A driver must maintain a minimum headway of two seconds at all times.","tags":["following"],"scenarios":["MergeIntoSlowTraffic","StaticCutIn"],"applies_when":{"all":["ego.lead.present",{"gt":["ego.speed_mps",2.0]},{"notnull":"ego.lead.headway_s"}]},"violated_when":{"sustained":[0.2,{"lt":["ego.lead.headway_s",2.0]}]},"quantifications":[{"term":"two seconds","value":2.0,"unit":"s","kind":"statute","note":"same number as BC-MVA-162-1 but reached differently: here it is stated in the rule, there it is a reading of 'reasonable and prudent'. The provenance differs even where the value agrees, and only the provenance says which one a mutation test is allowed to falsify."},{"term":"persistence","value":0.2,"unit":"s","kind":"reading","note":"stricter than BC's 1.0 s: this jurisdiction is drafted as an at-all-times duty"}]}
